# ─────────────────────────────────────────────────────────────
# Daksha Sewa Environment Variables Example Template
# Copy this file to .env.local and populate with your credentials:
# cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ───────── Supabase (Required) ─────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ───────── Site Configuration ─────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# ───────── Maps & Geocoding ─────────
NEXT_PUBLIC_MAP_STYLE_URL="https://api.maptiler.com/maps/dataviz-dark/style.json?key=your-key"
NEXT_PUBLIC_MAP_TILES=""
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
OSRM_BASE_URL="https://router.project-osrm.org"
GEOCODER_USER_AGENT="DakshaSewa/1.0 (contact: info@dakshasewa.com)"

# ───────── Payment Gateways ─────────
# eSewa (UAT defaults provided; use live merchant credentials in production)
ESEWA_PRODUCT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnLH"
ESEWA_FORM_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
ESEWA_STATUS_URL="https://rc.esewa.com.np/api/epay/transaction/status/"

# Khalti
KHALTI_BASE_URL="https://dev.khalti.com/api/v2"
KHALTI_SECRET_KEY=""

# Stripe (Optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ───────── Operations & Background Jobs ─────────
CRON_SECRET="generate-a-secure-random-32-byte-hex-string"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ───────── Email Delivery (SMTP) ─────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-app-password"
EMAIL_FROM="Daksha Sewa <noreply@example.com>"
ADMIN_NOTIFY_EMAIL="admin@example.com"

# ───────── Error Monitoring (Optional Sentry) ─────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
